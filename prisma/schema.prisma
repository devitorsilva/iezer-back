generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ModuleKey {
  LOGIN
  CADASTRO
  FINANCEIRO
  RELATORIOS
  MENSAGERIA
  COMPRAS
  PATRIMONIO
  MEMBROS
  CONFIGURACOES
  PORTAL_TRANSPARENCIA
  CONTEUDO
}

enum CategoryType {
  PAGAR
  RECEBER
  AMBOS
}

enum BankAccountType {
  CONTA_CORRENTE
  CONTA_POUPANCA
  CAIXA
  INVESTIMENTO
  OUTRA
}

enum PayableStatus {
  PAGO
  PENDENTE
  ATRASADO
}

enum ReceivableStatus {
  RECEBIDO
  PENDENTE
  ATRASADO
}

enum RecurrenceFrequency {
  QUINZENAL
  MENSAL
  ANUAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String    @id @default(cuid())
  module      ModuleKey
  action      String
  description String?
  createdAt   DateTime  @default(now())
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  cnpj        String   @unique
  email       String?
  phone       String?
  pixKey      String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payables    Payable[]
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType @default(AMBOS)
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payables    Payable[]
  receivables Receivable[]

  @@unique([name, type])
}

model BankAccount {
  id            String          @id @default(cuid())
  bankName      String
  accountName   String
  accountType   BankAccountType @default(CONTA_CORRENTE)
  agency        String?
  accountNumber String?
  pixKey        String?
  openingBalance Decimal        @default(0) @db.Decimal(14, 2)
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  settledPayables    Payable[]    @relation("PayableSettlementBankAccount")
  settledReceivables Receivable[] @relation("ReceivableSettlementBankAccount")

  @@unique([bankName, accountName])
}

model CostCenter {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
}

model Member {
  id          String       @id @default(cuid())
  name        String
  document    String?      @unique
  email       String?
  phone       String?
  cellName    String?
  birthDate   DateTime?
  notes       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  receivables Receivable[]

  @@index([name])
  @@index([isActive])
}

model Payable {
  id          String        @id @default(cuid())
  description String
  supplierId  String?
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dueDate     DateTime
  amount      Decimal       @db.Decimal(14, 2)
  status      PayableStatus @default(PENDENTE)
  settledAmount Decimal?    @db.Decimal(14, 2)
  settledAt   DateTime?
  settlementMethod String?
  settlementBankAccountId String?
  settlementBankAccount BankAccount? @relation("PayableSettlementBankAccount", fields: [settlementBankAccountId], references: [id], onDelete: SetNull)
  isRecurring Boolean       @default(false)
  recurrenceFrequency RecurrenceFrequency?
  recurrenceCount Int?
  recurrenceGroupId String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([supplierId])
  @@index([categoryId])
  @@index([dueDate])
  @@index([status])
  @@index([recurrenceGroupId])
  @@index([settlementBankAccountId])
}

model Receivable {
  id          String           @id @default(cuid())
  description String
  source      String
  memberId    String?
  member      Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dueDate     DateTime
  amount      Decimal          @db.Decimal(14, 2)
  status      ReceivableStatus @default(PENDENTE)
  settledAmount Decimal?       @db.Decimal(14, 2)
  settledAt   DateTime?
  settlementMethod String?
  settlementBankAccountId String?
  settlementBankAccount BankAccount? @relation("ReceivableSettlementBankAccount", fields: [settlementBankAccountId], references: [id], onDelete: SetNull)
  isRecurring Boolean          @default(false)
  recurrenceFrequency RecurrenceFrequency?
  recurrenceCount Int?
  recurrenceGroupId String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([memberId])
  @@index([categoryId])
  @@index([dueDate])
  @@index([status])
  @@index([recurrenceGroupId])
  @@index([settlementBankAccountId])
}
